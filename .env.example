# Vercel environment variables. Copy to .env for local work; set the real values in
# the Vercel dashboard per project (production and QA hold DIFFERENT values).
#
# Nothing here has a fallback in code by design. A missing variable must fail loudly:
# a fallback that quietly resolves to production is how a test environment writes
# real student data.

# ── Which environment this deployment is ──────────────────────────────────────
# 'production' or 'qa'. api/gas.mjs stamps this onto every request it proxies to
# Apps Script, which is how the backend decides which spreadsheet to open. The
# browser never sets it. Also gates the daily cron — only production may send.
APP_ENV=production

# ── Apps Script backend ───────────────────────────────────────────────────────
# The /exec URL of this environment's Apps Script DEPLOYMENT. Production and QA
# are two deployments of one script project, pinned to different versions, so
# these are two different URLs. Not the /dev URL — that one requires a signed-in
# editor and answers a server-side proxy with a Google sign-in page.
GAS_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Where api/tea-pipeline.mjs posts results back. Usually the same as GAS_URL.
GAS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# ── AI providers ──────────────────────────────────────────────────────────────
# Use separate keys per environment where the provider allows it. Shared keys mean
# QA test runs consume production rate limits and land on the same invoice with no
# way to tell the two apart.
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=

# Optional — code defaults apply when unset.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_FALLBACK_MODEL_2=

# ── Web push ──────────────────────────────────────────────────────────────────
# Generate a FRESH pair for QA: npx web-push generate-vapid-keys
# If QA reuses the production keys and its database ever holds copied subscriptions,
# real students receive test notifications on their phones.
#
# The matching PUBLIC key is also served to the browser by getClientConfigJson in
# Código.js, where it is currently a hardcoded literal rather than a property. Changing
# it here alone is not enough — the two must agree or every push fails validation.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret protecting /api/cron-streak-push. GAS_CRON_SECRET falls back to
# CRON_SECRET when unset. Use different values per environment.
CRON_SECRET=
GAS_CRON_SECRET=

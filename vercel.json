{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/tea.mjs":          { "maxDuration": 60 },
    "api/tea-pipeline.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron-streak-push", "schedule": "0 20 * * *" }
  ]
}
